  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__CLAUDE_DIR__/hooks/superpowers-session-start\"",
            "shell": "bash",
            "async": false
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_DIR__/hooks/reinject-loop-state.cjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_DIR__/hooks/block-main-commit-push.cjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_DIR__/hooks/record-edited-tree.cjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_DIR__/hooks/verify-on-stop.cjs\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "logout|prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_DIR__/hooks/session-end-cleanup.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
